{# exe/pages/index.html.jinja #}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <style>
        /*
         * The demo chrome is styled with stylescape; the specimens are styled
         * by boot.gl alone. Both live in stylescape's `ss` layer so they can
         * be slotted between its sublayers:
         *
         * - ss.specimen reverts every stylescape reset, typography and
         *   appearance rule inside .bootgl-specimen back to browser defaults;
         * - ss.bootgl (boot.gl itself) then applies on top of those defaults;
         * - stylescape's component and utility layers stay above both, so the
         *   ss-c-* / ss-u-* chrome classes keep their styling.
         */
        @layer ss.reset, ss.lexicon, ss.rhythm, ss.typography, ss.flow,
            ss.layout, ss.appearance, ss.specimen, ss.bootgl, ss.components,
            ss.utilities, ss.overrides;

        @layer ss.specimen {
            .bootgl-specimen * {
                all: revert;
            }
        }
    </style>
    <link rel="stylesheet" href="{{ stylescape_stylesheet }}">
    <style>
        @import url("{{ stylesheet }}") layer(ss.bootgl);
    </style>
</head>

<body>
    {%- include "partials/header.html.jinja" %}

    <main class="ss-u-py-8">
        <div class="ss-c-container ss-u-grid ss-u-gap-6">
            <section id="headings" class="ss-c-card" aria-labelledby="headings-title">
                <header class="ss-c-card__header">
                    <h2 id="headings-title" class="ss-c-card__title">Headings</h2>
                </header>
                <div class="ss-c-card__body ss-u-pt-4 bootgl-specimen">
                    <h3>Heading 3</h3>
                    <h4>Heading 4</h4>
                    <h5>Heading 5</h5>
                    <h6>Heading 6</h6>
                </div>
            </section>

            <section id="text" class="ss-c-card" aria-labelledby="text-title">
                <header class="ss-c-card__header">
                    <h2 id="text-title" class="ss-c-card__title">Text</h2>
                </header>
                <div class="ss-c-card__body ss-u-pt-4 bootgl-specimen">
                    <p>
                        A paragraph with <a href="#">a link</a>, <strong>strong</strong>, <em>emphasis</em>,
                        <small>small</small>, <mark>mark</mark>, <abbr title="Abbreviation">abbr</abbr>,
                        <code>code</code>, <kbd>Ctrl</kbd> + <kbd>C</kbd>, H<sub>2</sub>O and E = mc<sup>2</sup>.
                    </p>
                    <blockquote>
                        <p>A blockquote with an inline <q>quotation</q>.</p>
                    </blockquote>
                    <pre><code>pre > code {
    white-space: pre;
}</code></pre>
                    <hr>
                </div>
            </section>

            <section id="lists" class="ss-c-card" aria-labelledby="lists-title">
                <header class="ss-c-card__header">
                    <h2 id="lists-title" class="ss-c-card__title">Lists</h2>
                </header>
                <div class="ss-c-card__body ss-u-pt-4 bootgl-specimen">
                    <ul>
                        <li>Unordered item</li>
                        <li>Unordered item
                            <ol>
                                <li>Nested ordered item</li>
                            </ol>
                        </li>
                    </ul>
                    <dl>
                        <dt>Term</dt>
                        <dd>Description</dd>
                    </dl>
                </div>
            </section>

            <section id="table" class="ss-c-card" aria-labelledby="table-title">
                <header class="ss-c-card__header">
                    <h2 id="table-title" class="ss-c-card__title">Table</h2>
                </header>
                <div class="ss-c-card__body ss-u-pt-4 bootgl-specimen">
                    <table>
                        <caption>Caption</caption>
                        <thead>
                            <tr><th>Header</th><th>Header</th></tr>
                        </thead>
                        <tbody>
                            <tr><td>Cell</td><td>Cell</td></tr>
                        </tbody>
                    </table>
                </div>
            </section>

            <section id="forms" class="ss-c-card" aria-labelledby="forms-title">
                <header class="ss-c-card__header">
                    <h2 id="forms-title" class="ss-c-card__title">Forms</h2>
                </header>
                <div class="ss-c-card__body ss-u-pt-4 bootgl-specimen">
                    <form>
                        <fieldset>
                            <legend>Legend</legend>
                            <label for="demo-text">Text</label>
                            <input id="demo-text" type="text" placeholder="Placeholder">
                            <label for="demo-select">Select</label>
                            <select id="demo-select"><option>Option</option></select>
                            <label for="demo-textarea">Textarea</label>
                            <textarea id="demo-textarea"></textarea>
                            <button type="button">Button</button>
                        </fieldset>
                    </form>
                </div>
            </section>

            <div class="ss-c-card bootgl-specimen">
                <details>
                    <summary>Details</summary>
                    <p>Disclosed content.</p>
                </details>
            </div>

            <p hidden>This paragraph is hidden and should not appear.</p>
        </div>
    </main>
</body>

</html>
