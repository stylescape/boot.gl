{
    "name": "boot.gl",
    "private": true,
    "description": "Style Reset.",
    "version": "0.1.0",
    "keywords": [
        "boot.gl",
        "stylescape",
        "sass",
        "reset"
    ],
    "homepage": "https://www.boot.gl/",
    "author": "Lars van Vianen <lars@vianen.com> (https://www.vianen.com)",
    "contributors": [
        "Scape Press <info@scape.press>"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stylescape/boot.gl.git"
    },
    "bugs": {
        "url": "https://github.com/stylescape/boot.gl/issues"
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/scape-foundation"
        }
    ],
    "sass": "src/scss/index.scss",
    "style": "dist/css/boot.gl.css",
    "scripts": {
        "build": "npx kist --config ./kist.yml",
        "watch": "npx kist --config ./kist.yml --live",
        "dev": "vite",
        "lint": "stylelint \"src/scss/**/*.scss\"",
        "test": "node --test \"tst/**/*.test.mjs\"",
        "test:browser": "playwright test",
        "test:package": "node --test tst/package.e2e.mjs"
    },
    "engines": {
        "node": ">=20.19.0"
    },
    "devDependencies": {
        "@getkist/action-nunjucks": "^2.0.28",
        "@getkist/action-sass": "^1.0.4",
        "@playwright/test": "^1.64.0",
        "kist": "^0.1.81",
        "micromatch": "^4.0.8",
        "modern-normalize": "^3.0.1",
        "nunjucks": "^3.2.4",
        "postcss": "^8.5.29",
        "sass": "^1.97.3",
        "serve-static": "^2.2.1",
        "stylelint": "^17.16.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylescape": "^0.4.1",
        "vite": "^8.2.1"
    },
    "files": [
        "src/**",
        "dist/**"
    ],
    "exports": {
        ".": {
            "sass": "./src/scss/index.scss",
            "style": "./dist/css/boot.gl.css",
            "default": "./dist/css/boot.gl.css"
        },
        "./scss/*": "./src/scss/*",
        "./css/*": "./dist/css/*",
        "./package.json": "./package.json"
    }
}
